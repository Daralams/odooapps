<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gym_member_activity_view_tree" model="ir.ui.view">
        <field name="name">gym.member.activity.view.tree</field>
        <field name="model">gym.member.activity</field>
        <field name="arch" type="xml">
            <tree string="Gym Member Activity">
                <field name="name" />
                <field name="exercise" />
                <field name="equipment" />
                <field name="sets" />
                <field name="repeat" />
                <field name="weight" />
                <field name="date" />
            </tree>
        </field>
    </record>
    <record id="gym_member_activity_view_form" model="ir.ui.view">
        <field name="name">gym.member.activity.view.form</field>
        <field name="model">gym.member.activity</field>
        <field name="arch" type="xml">
            <form string="Gym Member Activity">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Mangandaralam"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="exercise" />
                            <field name="equipment" />
                            <field name="sets" />
                        </group>
                        <group>
                            <field name="repeat" />
                            <field name="weight" />
                            <field name="date" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="gym_member_activity_action" model="ir.actions.act_window">
        <field name="name">Gym Member Activity</field>
        <field name="res_model">gym.member.activity</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a member activity
            </p>
        </field>
    </record>
</odoo>