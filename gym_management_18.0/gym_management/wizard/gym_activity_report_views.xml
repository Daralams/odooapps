<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gym_activity_report_view_form" model="ir.ui.view">
        <field name="name">gym.activity.report.view.form</field>
        <field name="model">gym.activity.report</field>
        <field name="arch" type="xml">
            <form string="Gym Member Activity Report">
                <sheet>
                    <group>
                        <group>
                            <field name="start_date" />
                        </group>
                        <group>
                            <field name="end_date" />
                        </group>
                    </group>
                    <footer>
                        <button name="action_gym_activity_report_pdf" type="object"
                            class="btn-primary">
                            <i class="fa fa-file-pdf-o mr-2"/> Download PDF
                        </button>
                        <button name="action_gym_activity_report_excel" type="object"
                            class="btn-primary">
                            <i class="fa fa-file-excel-o mr-2"/> Download EXCEL
                        </button>
                        <button special="cancel" string="Cancel"
                            class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id="gym_activity_report_action" model="ir.actions.act_window">
        <field name="name">Gym Member Activity Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gym.activity.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="gym_activity_report_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>