<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gym_workouts_view_tree" model="ir.ui.view">
        <field name="name">gym.workouts.view.tree</field>
        <field name="model">gym.workouts</field>
        <field name="arch" type="xml">
            <tree string="Gym Workouts">
                <field name="name" />
                <field name="support_trainer" />
                <field name="workout_days" widget="many2many_tags"/>
            </tree>
        </field>
    </record>
    <record id="gym_workouts_view_kanban" model="ir.ui.view">
        <field name="name">gym.workouts.view.kanban</field>
        <field name="model">gym.workouts</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="name" />
                <field name="image" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image me-1">
                                <field name="image" widget="image" alt="Product" invisible="not image" class="o_image_64_contain"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="gym_workouts_view_view_form" model="ir.ui.view">
        <field name="name">gym.workouts.view.view.form</field>
        <field name="model">gym.workouts</field>
        <field name="arch" type="xml">
            <form string="Gym Workouts">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Bench press"/>
                        </h1>
                    </div>
                    <field name="image" widget="image" class="oe_avatar" nolabel="1"/>
                    <group>
                        <field name="support_trainer"/>
                        <field name="workout_days" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>
                    <notebook>
                        <page name="workouts-line" string="Workouts Line">
                            <group>
                                <field name="workout_ids" nolabel="1" colspan="2">
                                    <tree string="Workouts Line" editable="bottom">
                                        <field name="name" />
                                        <field name="exercise_for" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                        <field name="calories_burn" />
                                        <field name="equipments" />
                                        <field name="sets" />
                                        <field name="repeat" />
                                        <field name="weight" />
                                    </tree>
                                </field>
                            </group>
                        </page>
                        <page name="description" string="Description">
                            <field name="description" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="gym_workouts_action" model="ir.actions.act_window">
        <field name="name">Gym Workouts</field>
        <field name="res_model">gym.workouts</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Gym Workouts</p>
        </field>
    </record>
</odoo>