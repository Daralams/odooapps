<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gym_diet_plan_view_tree" model="ir.ui.view">
        <field name="name">gym.diet.plan.view.tree</field>
        <field name="model">gym.diet.plan</field>
        <field name="arch" type="xml">
            <list string="Diet Plan">
                <field name="name" />
                <field name="date" />
            </list>
        </field>
    </record>
    <record id="gym_diet_plan_view_form" model="ir.ui.view">
        <field name="name">gym.diet.plan.view.form</field>
        <field name="model">gym.diet.plan</field>
        <field name="arch" type="xml">
            <form string="Diet Plan">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="date" />
                    </group>
                    <notebook>
                        <page name="diet_meal" string="Diet Meal">
                            <group>
                                <field name="diet_ids" mode="list,kanban" nolabel="1" colspan="2">
                                    <list string="Diet Plan" editable="bottom">
                                        <field name="name" />
                                        <field name="quantity" />
                                        <field name="consume_at" />
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="gym_diet_plan_action" model="ir.actions.act_window">
        <field name="name">Diet Plan</field>
        <field name="res_model">gym.diet.plan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a diet plan
            </p>
        </field>
    </record>
</odoo>