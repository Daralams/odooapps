<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gym_trainer_skills_view_list" model="ir.ui.view">
        <field name="name">gym.trainer.skills.view.list</field>
        <field name="model">gym.trainer.skills</field>
        <field name="arch" type="xml">
            <list string="Trainer Skills">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="gym_trainer_skills_view_form" model="ir.ui.view">
        <field name="name">gym.trainer.skills.view.form</field>
        <field name="model">gym.trainer.skills</field>
        <field name="arch" type="xml">
            <form string="Trainer Skills">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="gym_trainer_skills_action" model="ir.actions.act_window">
        <field name="name">Trainer Skills</field>
        <field name="res_model">gym.trainer.skills</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Trainer Skills
            </p>
        </field>
    </record>
</odoo>