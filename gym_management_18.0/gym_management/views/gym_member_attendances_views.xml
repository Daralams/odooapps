<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gym_member_attendances_view_tree" model="ir.ui.view">
        <field name="name">gym.member.attendances.view.tree</field>
        <field name="model">gym.member.attendances</field>
        <field name="arch" type="xml">
            <list string="Member Attendance">
                <field name="name" />
                <field name="check_in" />
                <field name="check_out" />
                <field name="time_spent" />
            </list>
        </field>
    </record>
    <record id="gym_member_attendance_view_form" model="ir.ui.view">
        <field name="name">gym.member.attendance.view.form</field>
        <field name="model">gym.member.attendances</field>
        <field name="arch" type="xml">
            <form string="Member Attendance">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Mangandaralam"/>
                        </h1>
                    </div>
                    <group string="Attendance time">
                        <group>
                            <field name="check_in" />
                            <field name="check_out" />
                        </group>
                        <group>
                            <field name="time_spent" />
                        </group>
                    </group>
                    <notebook>
                        <page name="details" string="Details">
                            <group>
                                <field name="feedback" placeholder="your impressions and messages..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="gym_member_attendances_action" model="ir.actions.act_window">
        <field name="name">Member Attendance</field>
        <field name="res_model">gym.member.attendances</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Start recording your attendance
            </p>
        </field>
    </record>
</odoo>