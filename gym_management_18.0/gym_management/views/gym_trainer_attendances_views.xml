<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gym_trainer_attendances_view_list" model="ir.ui.view">
        <field name="name">gym.trainer.attendances.view.list</field>
        <field name="model">gym.trainer.attendances</field>
        <field name="arch" type="xml">
            <list string="Trainer Attendance" 
                decoration-success="attendance_status == 'finished'" 
                decoration-danger="attendance_status == 'unfinished'">
                <field name="name" />
                <field name="working_hours" />
                <field name="check_in" />
                <field name="check_out" />
                <field name="time_spent" />
                <field name="attendance_status" 
                widget="badge"
                decoration-success="attendance_status == 'finished'"
                decoration-danger="attendance_status == 'unfinished'"
                />
            </list>
        </field>
    </record>
    <record id="gym_trainer_attendances_view_form" model="ir.ui.view">
        <field name="name">gym.trainer.attendances.view.form</field>
        <field name="model">gym.trainer.attendances</field>
        <field name="arch" type="xml">
            <form string="Trainer Attendance">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Mangandaralam"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="working_hours" />
                            <field name="check_in" />
                            <field name="check_out" />
                        </group>
                        <group>
                            <field name="time_spent" />
                            <field name="attendance_status" 
                            widget="badge"
                            decoration-success="attendance_status == 'finished'"
                            decoration-danger="attendance_status == 'unfinished'"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="gym_trainer_attendances_action" model="ir.actions.act_window">
        <field name="name">Trainer Attendance</field>
        <field name="res_model">gym.trainer.attendances</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Start recording your attendance
            </p>
        </field>
    </record>
</odoo>