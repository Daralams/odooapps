<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_view_search_inherit" model="ir.ui.view">
        <field name="name">product.template.view.search.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_search_form_view_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='real_stock_available']" position="before">
                <filter name="gym_equipment" string="Gym Equipment" domain="[('gym_equipment_ok', '=', True)]" />
                <separator/>
            </xpath>
        </field>
    </record>
    <record id="product_template_view_form_inherit" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='purchase_ok']" position="after">
                <!-- <label for="gym_equipment_ok"> // gabisa jomok
                    <field name="gym_equipment_ok"/>
                </label> -->
                <!-- perbaiki bagian ini, tampilannya masih belum sesuai!! -->
                <field name="gym_equipment_ok" groups="gym_management.group_administor"/> 
            </xpath>
        </field>
    </record>
    <record id="gym_equipment_action" model="ir.actions.act_window">
        <field name="name">Gym Equipments</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('gym_equipment_ok', '=', True)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Gym Equipment</p>
        </field>
    </record>
</odoo>