<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gym_workout_days_view_tree" model="ir.ui.view">
        <field name="name">gym.workout.days.view.tree</field>
        <field name="model">gym.workout.days</field>
        <field name="arch" type="xml">
            <list string="Workout Days" editable="bottom">
                <field name="name" />
            </list>
        </field>
    </record>
    <record id="gym_workout_days_action" model="ir.actions.act_window">
        <field name="name">Workout Days</field>
        <field name="res_model">gym.workout.days</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Workout Days
            </p>
        </field>
    </record>
</odoo>