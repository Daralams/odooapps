<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gym_workouts_plan_view_tree" model="ir.ui.view">
        <field name="name">gym.workouts.plan.view.tree</field>
        <field name="model">gym.workouts.plan</field>
        <field name="arch" type="xml">
            <list string="Gym Workout Plan" editable="bottom">
                <field name="partner_id" />
                <field name="workout_id" />
                <field name="start_date" />
                <field name="end_date" />
            </list>
        </field>
    </record>
    <record id="gym_workouts_plan_action" model="ir.actions.act_window">
        <field name="name">Gym Workouts Plan</field>
        <field name="res_model">gym.workouts.plan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Gym workout plan</p>
        </field>
    </record>
</odoo>