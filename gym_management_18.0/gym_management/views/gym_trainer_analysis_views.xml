<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gym_trainer_analysis_view_graph" model="ir.ui.view">
        <field name="name">gym.trainer.analysis.view.graph</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <graph string="Gym Trainer Analysis" type="bar">
                <field name="status" />
                <field name="join_date" />
            </graph>
        </field>
    </record>
    <record id="gym_trainer_analysis_action" model="ir.actions.act_window">
        <field name="name">Gym Trainer Analysis</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">graph</field>
        <field name="domain">[('partner_role', '=', 'trainer')]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                There is no member joined at this time
            </p>
        </field>
    </record>
</odoo>