<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_gym_workout_reports" model="report.paperformat">
        <field name="name">Gym workout report</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">80</field>
    </record>
    <record id="report_gym_workout_action" model="ir.actions.report">
        <field name="name">Gym workout report</field>
        <field name="model">gym.workouts</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gym_management.report_gym_workouts</field>
        <field name="report_file">gym_management.report_gym_workouts</field>
        <field name="paperformat_id" ref="gym_management.paperformat_gym_workout_reports" />
        <field name="print_report_name">'Gym workout report - %s' % object.name</field>
        <field name="binding_model_id" ref="model_gym_workouts"/>
        <field name="binding_type">report</field>
    </record>
</odoo>